// Não é usado por "docusaurus start/build"; serve à IDE (tipos, autocompletar) e ao script "typecheck".
{
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "strict": true,
    "resolveJsonModule": true,
    "types": ["@docusaurus/module-type-aliases", "@docusaurus/theme-classic", "@docusaurus/theme-live-codeblock"]
  },
  "include": ["src", "docusaurus.config.ts", "sidebars.ts"],
  "exclude": [".docusaurus", "build"]
}
