[
  {
    "id": "ob-tip-kf",
    "css": "@keyframes ob-tip { from { opacity: 0; } }"
  },
  {
    "id": "ob-buttongroup-split-css",
    "css": "[data-bg-split]>*{display:flex!important;align-items:stretch}[data-bg-split]>*>span{display:flex!important;align-items:stretch}[data-bg-split]>*>span>button{height:auto!important;align-self:stretch}"
  },
  {
    "id": "ob-calendar-dia",
    "css": ".ob-calendar-dia:focus-visible{outline:2px solid var(--ob-blue);outline-offset:-2px}"
  },
  {
    "id": "ob-skeleton-kf",
    "css": "@keyframes ob-shimmer { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }"
  },
  {
    "id": "ob-accordion",
    "css": ".ob-accordion-cabecalho{transition:background 120ms}.ob-accordion-cabecalho:hover:not(:disabled){background:var(--ob-bg-alt)}.ob-accordion-cabecalho:focus-visible{outline:2px solid var(--ob-blue);outline-offset:-2px}"
  },
  {
    "id": "ob-spin-kf",
    "css": "@keyframes ob-spin{to{transform:rotate(360deg)}}"
  },
  {
    "id": "ob-indet-kf",
    "css": "@keyframes ob-indet{0%{left:-40%;width:40%}50%{width:55%}100%{left:100%;width:40%}}"
  },
  {
    "id": "ob-toast-kf",
    "css": "@keyframes ob-toast-in-top{from{opacity:0;transform:translateY(-16px)}to{opacity:1;transform:translateY(0)}}@keyframes ob-toast-out-top{from{opacity:1;transform:translateY(0)}to{opacity:0;transform:translateY(-16px)}}@keyframes ob-toast-in-bottom{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}@keyframes ob-toast-out-bottom{from{opacity:1;transform:translateY(0)}to{opacity:0;transform:translateY(16px)}}"
  },
  {
    "id": "ob-toast-pos",
    "css": "@media(max-width:600px){.ob-toast-stack{left:50%!important;right:auto!important;transform:translateX(-50%)!important;width:calc(100vw - 24px)!important;align-items:stretch!important}.ob-toast-stack[data-pos^=\"top\"]{top:16px!important;bottom:auto!important;flex-direction:column-reverse!important}.ob-toast-stack[data-pos^=\"bottom\"]{bottom:16px!important;top:auto!important;flex-direction:column!important}}"
  },
  {
    "id": "ob-shake-kf",
    "css": "@keyframes ob-shake{10%,90%{transform:translateX(-1px)}20%,80%{transform:translateX(2px)}30%,50%,70%{transform:translateX(-4px)}40%,60%{transform:translateX(4px)}}"
  },
  {
    "id": "ob-sidenav-scroll",
    "css": ".ob-sidenav-lista::-webkit-scrollbar{width:6px}.ob-sidenav-lista::-webkit-scrollbar-button{display:none}.ob-sidenav-lista::-webkit-scrollbar-track{background:transparent}.ob-sidenav-lista::-webkit-scrollbar-thumb{background:transparent;border-radius:999px}.ob-sidenav-lista:hover::-webkit-scrollbar-thumb{background:color-mix(in srgb,var(--ob-fg-mute) 60%,transparent)}@supports not selector(::-webkit-scrollbar){.ob-sidenav-lista{scrollbar-width:thin;scrollbar-color:color-mix(in srgb,var(--ob-fg-mute) 60%,transparent) transparent}}"
  },
  {
    "id": "ob-pulse-kf",
    "css": "@keyframes ob-pulse{0%,100%{opacity:1}50%{opacity:.4}}"
  },
  {
    "id": "ob-modal-kf",
    "css": "@keyframes ob-fade { from { opacity: 0; } to { opacity: 1; } } @keyframes ob-pop { from { opacity: 0; transform: scale(0.96) translateY(8px); } to { opacity: 1; transform: scale(1) translateY(0); } }"
  },
  {
    "id": "ob-fileupload",
    "css": ".ob-fileupload-imagem .ob-fileupload-camada{opacity:0;transition:opacity 150ms}.ob-fileupload-imagem:hover .ob-fileupload-camada,.ob-fileupload-imagem:focus-visible .ob-fileupload-camada{opacity:1}.ob-fileupload-imagem:focus-visible{outline:2px solid var(--ob-blue);outline-offset:2px}"
  },
  {
    "id": "ob-treeview-kf",
    "css": "\n.ob-tv-row{outline:none}\n.ob-tv-row:focus-visible{box-shadow:inset 0 0 0 2px var(--ob-blue)}\n.ob-tv-row .ob-tv-act{opacity:0;transition:opacity .12s}\n.ob-tv-row:hover .ob-tv-act,.ob-tv-row:focus-within .ob-tv-act{opacity:1}\n.ob-tv-caret:hover,.ob-tv-handle:hover{background:var(--ob-bg-alt);color:var(--ob-fg-strong)}\n.ob-tv-handle{cursor:grab;touch-action:none}\n@keyframes ob-tv-lift{from{transform:scale(1) rotate(0);box-shadow:var(--ob-shadow-sm)}to{transform:scale(1.03) rotate(1.5deg);box-shadow:var(--ob-shadow-lg)}}\n@keyframes ob-tv-flash{from{background:var(--ob-blue-100)}to{background:transparent}}\n"
  }
]
