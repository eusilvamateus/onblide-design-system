    "css": ".ob-accordion-cabecalho{transition:background var(--ob-dur-fast) var(--ob-ease)}.ob-accordion-cabecalho:hover:not(:disabled){background:var(--ob-bg-alt)}.ob-accordion-cabecalho:focus-visible{outline:var(--ob-focus-ring-width) solid var(--ob-focus-ring);outline-offset:calc(var(--ob-focus-ring-width) * -1)}"
  },
  {
    "id": "ob-spin-kf",
    "css": "@keyframes ob-spin{to{transform:rotate(360deg)}}"
  },
  {
    "id": "ob-indet-kf",
    "css": "@keyframes ob-indet{0%{left:-40%;width:40%}50%{width:55%}100%{left:100%;width:40%}}"
  },
  {
    "id": "ob-toast-kf",
    "css": "@keyframes ob-toast-in-top{from{opacity:0;transform:translateY(-16px)}to{opacity:1;transform:translateY(0)}}@keyframes ob-toast-out-top{from{opacity:1;transform:translateY(0)}to{opacity:0;transform:translateY(-16px)}}@keyframes ob-toast-in-bottom{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}@keyframes ob-toast-out-bottom{from{opacity:1;transform:translateY(0)}to{opacity:0;transform:translateY(16px)}}"
  },
  {
    "id": "ob-toast-pos",
    "css": ".ob-toast-stack{position:fixed;z-index:var(--ob-z-toast);display:flex;gap:10px;pointer-events:none;left:50%;transform:translateX(-50%);width:calc(100vw - 24px);align-items:stretch}.ob-toast-stack[data-pos^=\"top\"]{top:16px;flex-direction:column-reverse}.ob-toast-stack[data-pos^=\"bottom\"]{bottom:16px;flex-direction:column}@media (min-width: 768px){.ob-toast-stack{width:min(400px,calc(100vw - 32px))}.ob-toast-stack[data-pos^=\"top\"]{top:24px}.ob-toast-stack[data-pos^=\"bottom\"]{bottom:24px}.ob-toast-stack[data-pos$=\"-left\"]{left:24px;transform:none;align-items:flex-start}.ob-toast-stack[data-pos$=\"-right\"]{left:auto;right:24px;transform:none;align-items:flex-end}.ob-toast-stack[data-pos$=\"-center\"]{align-items:center}}"
  },
  {
    "id": "ob-shake-kf",
    "css": "@keyframes ob-shake{10%,90%{transform:translateX(-1px)}20%,80%{transform:translateX(2px)}30%,50%,70%{transform:translateX(-4px)}40%,60%{transform:translateX(4px)}}"
  },
  {
    "id": "ob-pulse-kf",
