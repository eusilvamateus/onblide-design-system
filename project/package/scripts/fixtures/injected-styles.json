  },
  {
    "id": "ob-modal-layout",
    "css": ".ob-modal-fundo{padding:0}.ob-modal{width:100%;height:100%;max-height:100%;border-radius:0}.ob-modal-fundo[data-cartao]{padding:16px}.ob-modal-fundo[data-cartao] .ob-modal{width:var(--ob-modal-largura);height:auto;max-height:var(--ob-modal-altura);border-radius:var(--ob-r-overlay)}@media (min-width: 768px){.ob-modal-fundo,.ob-modal-fundo[data-cartao]{padding:24px}.ob-modal{width:var(--ob-modal-largura);height:auto;max-height:var(--ob-modal-altura);border-radius:var(--ob-r-overlay)}}"
  },
  {
    "id": "ob-modal-kf",
