  {
    "id": "ob-scrollarea",
    "css": ".ob-sa-viewport{scrollbar-width:none;-ms-overflow-style:none}.ob-sa-viewport::-webkit-scrollbar{display:none}.ob-sa-viewport:focus{outline:none}.ob-sa-viewport:focus-visible{box-shadow:inset 0 0 0 var(--ob-focus-ring-width) var(--ob-focus-ring)}.ob-sa-barra{position:absolute;z-index:1;box-sizing:border-box;display:flex;touch-action:none;user-select:none;opacity:0;transition:opacity var(--ob-dur-base) var(--ob-ease)}.ob-sa-barra[data-eixo=\"v\"]{top:0;right:0;width:12px;padding:2px 3px;flex-direction:column}.ob-sa-barra[data-eixo=\"h\"]{left:0;bottom:0;height:12px;padding:3px 2px;flex-direction:row}.ob-sa-polegar{position:relative;border-radius:var(--ob-r-pill);background:var(--ob-scrollbar-thumb);transition:background var(--ob-dur-fast) var(--ob-ease),width var(--ob-dur-fast) var(--ob-ease),height var(--ob-dur-fast) var(--ob-ease);cursor:default}.ob-sa-barra[data-eixo=\"v\"] .ob-sa-polegar{width:6px;align-self:center}.ob-sa-barra[data-eixo=\"h\"] .ob-sa-polegar{height:6px;align-self:center}.ob-sa-barra:hover .ob-sa-polegar,.ob-sa-polegar[data-arrastando]{background:var(--ob-scrollbar-thumb-hover)}.ob-sa-barra[data-eixo=\"v\"]:hover .ob-sa-polegar,.ob-sa-barra[data-eixo=\"v\"] .ob-sa-polegar[data-arrastando]{width:8px}.ob-sa-barra[data-eixo=\"h\"]:hover .ob-sa-polegar,.ob-sa-barra[data-eixo=\"h\"] .ob-sa-polegar[data-arrastando]{height:8px}.ob-sa[data-visibilidade=\"always\"] .ob-sa-barra{background:var(--ob-scrollbar-track);border-radius:var(--ob-r-pill)}.ob-sa[data-visibilidade=\"auto\"] .ob-sa-barra,.ob-sa[data-visibilidade=\"always\"] .ob-sa-barra,.ob-sa:hover .ob-sa-barra,.ob-sa:focus-within .ob-sa-barra,.ob-sa[data-ativa] .ob-sa-barra{opacity:1}"
  },
  {
    "id": "ob-skeleton-kf",
    "css": "@keyframes ob-shimmer { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }"
