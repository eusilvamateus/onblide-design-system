      "cardMode": "column"
    },
    "Select": {
      "cardMode": "column"
    },
    "Skeleton": {
      "cardMode": "column"
    },
    "Table": {
      "cardMode": "column"
    },
    "Tabs": {
      "cardMode": "column"
    },
    "Toast": {
      "cardMode": "column"
    },
    "Card": {
      "cardMode": "column"
    },
    "Datepicker": {
      "cardMode": "column"
    },
    "DeadlineCalendar": {
      "cardMode": "column"
    },
    "FieldShell": {
      "cardMode": "column"
